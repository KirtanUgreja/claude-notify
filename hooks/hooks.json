{
  "_comment": "Two entries per event on purpose. Windows cannot spawn a bare `sh` (Git Bash's sh.exe is not on the system PATH), so it calls powershell.exe directly; macOS/Linux cannot spawn powershell.exe. Whichever entry does not apply fails to spawn, which is a silent non-blocking error, so exactly one fires per platform.",

  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/notify.sh", "permission"],
            "async": true
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
                     "${CLAUDE_PLUGIN_ROOT}/scripts/notify.ps1",
                     "-Title", "Claude needs you",
                     "-Body", "Waiting for permission.",
                     "-Kind", "permission"],
            "async": true
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/notify.sh", "idle"],
            "async": true
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
                     "${CLAUDE_PLUGIN_ROOT}/scripts/notify.ps1",
                     "-Title", "Claude is waiting",
                     "-Body", "Ready for your next prompt.",
                     "-Kind", "idle"],
            "async": true
          }
        ]
      },
      {
        "matcher": "agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/notify.sh", "permission"],
            "async": true
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
                     "${CLAUDE_PLUGIN_ROOT}/scripts/notify.ps1",
                     "-Title", "Claude needs you",
                     "-Body", "A background session is waiting.",
                     "-Kind", "permission"],
            "async": true
          }
        ]
      },
      {
        "matcher": "agent_completed",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/notify.sh", "done"],
            "async": true
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
                     "${CLAUDE_PLUGIN_ROOT}/scripts/notify.ps1",
                     "-Title", "Claude finished",
                     "-Body", "A background session finished.",
                     "-Kind", "done"],
            "async": true
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/notify.sh", "permission"],
            "async": true
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
                     "${CLAUDE_PLUGIN_ROOT}/scripts/notify.ps1",
                     "-Title", "Claude needs you",
                     "-Body", "A form is waiting for input.",
                     "-Kind", "permission"],
            "async": true
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/notify.sh", "done"],
            "async": true
          },
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
                     "${CLAUDE_PLUGIN_ROOT}/scripts/notify.ps1",
                     "-Title", "Claude finished",
                     "-Body", "Response complete.",
                     "-Kind", "done"],
            "async": true
          }
        ]
      }
    ]
  }
}
